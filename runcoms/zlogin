# Execute code that does not affect the current session in the background.
{
  [[ $+commands[compile-completions] ]] && compile-completions || true
  [[ "$OSTYPE" == darwin* ]] && [[ $+commands[update-system-env] ]] && update-system-env || true
} &!

if [[ "$PROFILE_STARTUP" == true ]]; then
  zprof
  unsetopt xtrace
  exec 2>&3 3>&-
fi

