alias to-lower='tr "[:upper:]" "[:lower:]"'
alias to-upper='tr "[:lower:]" "[:upper:]"'

if is-darwin; then
  alias list-open-ports='lsof -Pn -i4'
fi

if [[ -x ~/.config/tmux/plugins/tmux-ctrlp/bin/ctrlp ]]; then
  path+=(~/.config/tmux/plugins/tmux-ctrlp/bin)
  alias t='~/.config/tmux/plugins/tmux-ctrlp/bin/ctrlp'
fi

if (( ${+commands[fd]} )); then
  unalias fd
  alias fd='noglob fd'
fi

#
# Hooks and Completions
#

function cache-completions {
  local force="${1:-false}"

  [[ -d "$site_functions_path" ]] || mkdir -p "$site_functions_path"

  # Completion caching
  typeset -A compl_commands=(
    codex                       'codex completion zsh'
    colima                      'colima completion zsh'
    comfy                       'comfy --show-completion'
    doctl                       'doctl completion zsh'
    eww                         'eww shell-completions --shell zsh'
    hf                          'hf --show-completion'
    just                        'just --completions zsh'
    kubectl                     'kubectl completion zsh'
    nexus                       'nexus completion zsh'
    op                          'op completion zsh'
    openclaw                    'openclaw completion --shell zsh'
    opencode                    'opencode completion'
    poetry                      'poetry completions zsh'
    register-python-argcomplete 'register-python-argcomplete pipx'
    sk                          'sk --shell zsh'
    walrus                      'walrus completion --shell zsh'
  )

  for compl_command in "${(k)compl_commands[@]}"; do
    if (( $+commands[$compl_command] )); then
      function_file="$site_functions_path/_$compl_command"

      # Completion commands are slow; check if the command is included
      # in the functions array.
      if [[ -z "${(k)functions[(Ie)_${compl_command}]}" ]] || [[ "$force" == true ]]; then
        echo "Generating completion for $compl_command..."
        command ${=compl_commands[$compl_command]} >! "$function_file" 2> /dev/null
      fi

      unset function_file
    fi
  done

  unset compl_command{s,}

  # Load bash completions
  autoload -U +X bashcompinit && bashcompinit
}

cache-completions

# direnv
is-callable direnv && eval "$(direnv hook zsh)"

# FZF - Shell Fuzzy Finder
if is-callable fzf; then
  [[ ! -f ${PREZTO_CACHE_DIR}/fzf.zsh ]] && fzf --zsh >! ${PREZTO_CACHE_DIR}/fzf.zsh
  source ${PREZTO_CACHE_DIR}/fzf.zsh
fi

# Load zoxide
is-callable zoxide && eval "$(zoxide init zsh)"

# Initialize 1Ppassword CLI plugins
[[ -f ~/.config/op/plugins.sh ]] && source ~/.config/op/plugins.sh

#
# Helper functions
#

function nvm-enable {
  if [[ "$OSTYPE" == darwin* ]]; then
    nvm_prefix=$(brew --prefix nvm)
  fi
  [[ -d $nvm_prefix ]] && source $nvm_prefix/nvm.sh
}

function update-system-env {
  [[ "$OSTYPE" == darwin* ]] || return

  launchctl setenv PATH "${PATH}"

  for var in $(env | grep _HOME | awk -F= '{print $1}'); do
    launchctl setenv $var "${(P)var}"
  done
}

function zupdate() {
  git -C "${PREZTO_HOME}" stash -u \
    && git -C "${PREZTO_HOME}" pull --rebase --prune \
    && git -C "${PREZTO_HOME}" stash pop

  if [[ -d ${PREZTO_HOME}/contrib ]]; then
    git -C "${PREZTO_HOME}/contrib" stash -u \
      && git -C "${PREZTO_HOME}/contrib" pull --rebase --prune \
      && git -C "${PREZTO_HOME}/contrib" stash pop
  fi
}

function yadm-prezto() {
  yadm add ${PREZTO_HOME} && yadm cis -m 'build: update prezto'
}

function yadm-nvim() {
  yadm add ~/.config/nvim && yadm cis -m 'build: update nvim'
}

function cdtmp() {
  local TMPDIR="$(mktemp -d)"
  ${SHELL} -c "cd ${TMPDIR}; ${SHELL}; rm -rf ${TMPDIR}"
}

function random() {
  local min="$1"
  local max="$2"

  range=$((max - min + 1))
  rand=$((min + (RANDOM % range)))

  echo "$rand"
}

# Cleans stopped containers, dangling images, and dettached volumes
function dkclean {
  docker ps -a --quiet \
    -f 'status=created' \
    -f 'status=removing' \
    -f 'status=paused' \
    -f 'status=exited' \
    | xargs -I {} docker rm {}
  docker images | grep '<none>' | awk '{print $3}' | xargs docker rmi
  docker volume prune
}

# Archway
if is-callable archwayd; then
  function gas-prices-estimate() {
    local node_url="${1}"
    local node="$([[ -n "$node_url" ]] && echo "--node ${node_url}" || echo "")"
    archwayd q rewards estimate-fees 1 ${node} --output json | \
      jq -r '.gas_unit_price | (.amount + .denom)'
  }

  function arch-config-client() {
    local chain_id="${1}"

    [[ -f ~/.archway/config/client.${chain_id}.toml ]] || {
      echo "No client config found for chain ${chain_id}"
      return 1
    }

    ln -sf client.${chain_id}.toml ~/.archway/config/client.toml
    cat ~/.archway/config/client.toml
  }
fi

# Sui
if is-callable sui; then
  function sui-address() {
    sui client addresses --json 2>/dev/null | jq --arg addr "$1" -er '.addresses[] | select(.[0] == $addr) | .[1]'
  }
fi

# Load local zshrc
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

